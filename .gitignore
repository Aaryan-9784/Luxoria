# ================================================================
#  LUXORIA — Root .gitignore
#  Enterprise-grade exclusions for MERN Stack Architecture
# ================================================================

# ────────────────────────────────────────────────────────────────
#  Dependencies & Package Managers
# ────────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
.npm/
.yarn/
.pnp
.pnp.*
.pnpm-store/
.bun/
package-lock.json

# ────────────────────────────────────────────────────────────────
#  Environment Variables & Secrets (Keep .env.example safe)
# ────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
*.env

# Secrets, Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.p12
*.pfx
*.p8
*.jks
private_key.pem
public_key.pem
serviceAccountKey.json
google-credentials.json
firebase-adminsdk*.json

# ────────────────────────────────────────────────────────────────
#  Build Outputs, Bundler Caches & Generated Assets
# ────────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
.tscache/
.rollup.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.cache/

# ────────────────────────────────────────────────────────────────
#  Logs & Process Runtime Files
# ────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.node_repl_history

# ────────────────────────────────────────────────────────────────
#  Uploads, Temporary Media & Local Storage
# ────────────────────────────────────────────────────────────────
backend/uploads/
backend/public/uploads/
backend/temp/
frontend/public/uploads/
uploads/
temp/
tmp/
*.tmp
*.bak
*.backup

# Heavy raw media archives (Use Cloudinary CDN)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.psd
*.ai

# ────────────────────────────────────────────────────────────────
#  Testing, Coverage & Reports
# ────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
cypress/screenshots/
cypress/videos/
.jest-cache/

# ────────────────────────────────────────────────────────────────
#  Database & Local Storage Dumps
# ────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
data/db/

# ────────────────────────────────────────────────────────────────
#  IDEs, Editors & Workstations
# ────────────────────────────────────────────────────────────────
# JetBrains
.idea/

# Visual Studio / VS Code
*.suo
*.ntvs*
*.njsproj
*.sln
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Sublime / Emacs
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace

# ────────────────────────────────────────────────────────────────
#  AI Agents, Scratch Files & IDE Caches
# ────────────────────────────────────────────────────────────────
.gemini/
.brain/
.agents/
.system_generated/
brain/
scratch/
.cursor/
.copilot/
notes.md
todo.md
*.todo

# Temporary Scratch Scripts
backend/src/scripts/clearData.js
backend/check_*.js
backend/clear_*.js
backend/fix_*.js
backend/get_*.js
backend/test*.js
backend/seed*.js
frontend/get_cars.*

# ────────────────────────────────────────────────────────────────
#  OS-Specific System Artifacts
# ────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.AppleDB

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory

# ────────────────────────────────────────────────────────────────
#  Deployment & Cloud Provider Cache
# ────────────────────────────────────────────────────────────────
.vercel/
.netlify/
.serverless/
.firebase/
.wrangler/
render-build.log
.render-build-log
fly.toml
docker-compose.override.yml
