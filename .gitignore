# ================================================================
#  LUXORIA — Root .gitignore
#  Comprehensive exclusions for MERN stack project
# ================================================================


# ──────────────────────────────────────────────────────────────────
#  Dependencies & Package Managers
# ──────────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
.npm/
.yarn/
.pnp.*
.pnpm-store/
package-lock.json


# ──────────────────────────────────────────────────────────────────
#  Environment Variables & Secrets
# ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.production
.env.production.local
*.env
!.env.example
!.env.sample


# ──────────────────────────────────────────────────────────────────
#  Secrets, Keys & Certificates
# ──────────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
*.pfx
*.p8
*.jks
private_key.pem
public_key.pem
serviceAccountKey.json
google-credentials.json
firebase-adminsdk*.json


# ──────────────────────────────────────────────────────────────────
#  Build Outputs & Bundler Caches
# ──────────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
.tscache/
.rollup.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.next/
.nuxt/


# ──────────────────────────────────────────────────────────────────
#  Logs & Process Output
# ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ──────────────────────────────────────────────────────────────────
#  Uploads, Heavy Media & Temporary Files
# ──────────────────────────────────────────────────────────────────
backend/uploads/
backend/public/uploads/
backend/temp/
frontend/public/uploads/
*.tmp
*.bak
*.backup

# Large video files (use Cloudinary / CDN instead)
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Large image archives
*.psd
*.ai

# Personal photo files at root
*.jpeg
*.jpg
!frontend/public/**/*.jpeg
!frontend/public/**/*.jpg


# ──────────────────────────────────────────────────────────────────
#  Testing & Code Coverage
# ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
cypress/screenshots/
cypress/videos/
.jest-cache/


# ──────────────────────────────────────────────────────────────────
#  Database Files
# ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/db/


# ──────────────────────────────────────────────────────────────────
#  IDEs, Editors & AI Agent Artifacts
# ──────────────────────────────────────────────────────────────────
# JetBrains
.idea/

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# Vim / Neovim swap files
*.swp
*.swo
*.swn
*~

# VS Code (allow shared settings)
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# AI agents & generated caches
.gemini/
.brain/
.agents/
.system_generated/
brain/
scratch/
.cursor/
.copilot/


# ──────────────────────────────────────────────────────────────────
#  OS-Specific System Files
# ──────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.AppleDB

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
*.lnk

# Linux
.directory
*.swp


# ──────────────────────────────────────────────────────────────────
#  Deployment & Hosting Platforms
# ──────────────────────────────────────────────────────────────────
.vercel/
.netlify/
.serverless/
.firebase/
.wrangler/
.render-build-log
render-build.log
fly.toml


# ──────────────────────────────────────────────────────────────────
#  Docker
# ──────────────────────────────────────────────────────────────────
docker-compose.override.yml
.dockerignore


# ──────────────────────────────────────────────────────────────────
#  Development Scripts & Scratch Files
#  (One-off debug/test/seed scripts at backend root)
# ──────────────────────────────────────────────────────────────────
backend/check_*.js
backend/clear_*.js
backend/fix_*.js
backend/get_*.js
backend/test*.js
backend/update_images.js
backend/seed*.js
frontend/get_cars.*


# ──────────────────────────────────────────────────────────────────
#  Miscellaneous
# ──────────────────────────────────────────────────────────────────
*.tgz
*.tar.gz
*.zip
*.rar
*.7z
.node_repl_history
notes.md
todo.md
*.todo
