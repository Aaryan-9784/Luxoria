# ==============================================================================
#  LUXORIA SPA — Frontend Environment Configuration Template
# ==============================================================================
#  INSTRUCTIONS:
#  1. For Local Development:
#     - Copy this file to '.env':  cp .env.example .env
#     - Default values are already pre-configured for local Vite dev server.
#
#  2. For Production Deployment on Vercel (https://vercel.com):
#     - Navigate to your Vercel Project -> Settings -> Environment Variables.
#     - Add each key below to the 'Production' (and 'Preview') environments.
#     - Redeploy your project after adding or updating variables.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. BACKEND API ENDPOINT (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# The full HTTP/HTTPS base URL pointing to the Luxoria Express API backend.
# IMPORTANT: Must include '/api' at the end and NO trailing slash.
#
# Production (Render):  https://luxoria-backend.onrender.com/api
# Local Development:    http://localhost:5000/api
VITE_API_URL=https://luxoria-backend.onrender.com/api


# ──────────────────────────────────────────────────────────────────────────────
# 2. PAYMENT GATEWAY — RAZORPAY PUBLIC KEY (REQUIRED FOR BOOKING CHECKOUT)
# ──────────────────────────────────────────────────────────────────────────────
# Your public Razorpay Key ID (never put your Key Secret in frontend!).
# Get from: https://dashboard.razorpay.com/app/keys
#
# Test Mode Example:  rzp_test_TbTnFf3DXAU6QJ
# Live Mode Example:  rzp_live_yourLiveKeyIdHere
VITE_RAZORPAY_KEY_ID=rzp_test_yourRazorpayKeyIdHere


# ──────────────────────────────────────────────────────────────────────────────
# 3. CURRENCY EXCHANGE RATE (OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# Multiplier used across vehicle pricing, deposit calculations, and checkout.
# 1 USD to Indian Rupee (INR) conversion rate fallback.
# Default: 86.5
VITE_USD_TO_INR_RATE=86.5
