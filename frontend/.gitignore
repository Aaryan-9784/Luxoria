# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Environment Configurations
.env
.env.*
!.env.example

# Production Build & Bundler Cache
dist/
dist-ssr/
build/
out/
.vite/
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Testing & Coverage
coverage/
playwright-report/

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# Deployment Previews
.vercel/
.netlify/
