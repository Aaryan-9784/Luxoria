# ==============================================================================
#  LUXORIA API — Backend Environment Configuration Template
# ==============================================================================
#  INSTRUCTIONS:
#  1. For Local Development:
#     - Copy this file to '.env':  cp .env.example .env
#     - Fill in your local/cloud database URI and secrets.
#
#  2. For Production Deployment on Render (https://dashboard.render.com):
#     - In your Render Web Service dashboard, navigate to: Environment -> Environment Variables.
#     - Add each REQUIRED key below.
#     - Note: If using render.yaml Blueprint, JWT secrets are generated automatically!
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. APPLICATION CORE (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Server port (Render sets this automatically; defaults to 5000)
PORT=5000

# Environment mode: 'production' for live deployment, 'development' for local
NODE_ENV=production

# Client URL: Exact frontend domain WITHOUT trailing slash (used for CORS & cookie validation)
# Production (Vercel):  https://luxoria.vercel.app
# Local Development:    http://localhost:5173
CLIENT_URL=https://luxoria.vercel.app


# ──────────────────────────────────────────────────────────────────────────────
# 2. DATABASE — MONGODB ATLAS (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# MongoDB connection URI (Cloud Atlas or local MongoDB)
# Get from: https://cloud.mongodb.com -> Connect -> Drivers -> Node.js
# Ensure Network Access in Atlas allows '0.0.0.0/0' for cloud providers like Render.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:yourPasswordHere@cluster0.abcde.mongodb.net/luxoria?retryWrites=true&w=majority


# ──────────────────────────────────────────────────────────────────────────────
# 3. AUTHENTICATION & JWT SECURITY (REQUIRED)
# ──────────────────────────────────────────────────────────────────────────────
# Secure random strings (at least 32-64 characters)
# Generate with terminal command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_key_generate_with_crypto_hex_32_bytes
JWT_REFRESH_SECRET=your_super_secret_refresh_key_generate_with_crypto_hex_32_bytes

# Token expiration lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ──────────────────────────────────────────────────────────────────────────────
# 4. PAYMENT GATEWAY — RAZORPAY (REQUIRED FOR BOOKING CHECKOUT)
# ──────────────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys (Test or Live mode)
# If left blank, the server will start in demo mode (online payments disabled).
RAZORPAY_KEY_ID=rzp_test_yourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere

# Optional webhook signature secret for payment events (Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere


# ──────────────────────────────────────────────────────────────────────────────
# 5. MEDIA STORAGE CDN — CLOUDINARY (REQUIRED FOR FLEET & AVATAR UPLOADS)
# ──────────────────────────────────────────────────────────────────────────────
# Get from: https://console.cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_key


# ──────────────────────────────────────────────────────────────────────────────
# 6. TRANSACTIONAL EMAIL & NOTIFICATIONS (OPTIONAL / RECOMMENDED)
# ──────────────────────────────────────────────────────────────────────────────
# OPTION A (Recommended for Render/Vercel): Resend API
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_yourResendApiKeyHere

# OPTION B (Standard SMTP / Gmail / Mailtrap fallback):
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=concierge@luxoria.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="LUXORIA Concierge" <concierge@luxoria.com>

# Administrative notification recipients:
ADMIN_EMAIL=admin@luxoria.com
SUPPORT_EMAIL=support@luxoria.com


# ──────────────────────────────────────────────────────────────────────────────
# 7. SOCIAL AUTHENTICATION — GOOGLE OAUTH 2.0 (OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized Redirect URI must match:
# Production: https://<your-render-api-domain>/api/auth/google/callback
# Local:      http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-yourGoogleClientSecretKey
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# ──────────────────────────────────────────────────────────────────────────────
# 8. BUSINESS CONFIGURATION (OPTIONAL)
# ──────────────────────────────────────────────────────────────────────────────
# Currency conversion rate (1 USD to INR) fallback
USD_TO_INR_RATE=86.50
